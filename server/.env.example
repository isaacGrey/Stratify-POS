DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffeesaas
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
MAIL_FROM=Coffee SaaS <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Absolute path to a private P-256 signing key outside the project (optional)
OFFLINE_PRIVATE_KEY_FILE=
REPORT_TIME_ZONE=Asia/Manila
APP_PUBLIC_URL=

# Use a mounted backup volume with a .stratifypos-backup-store marker file.
BACKUP_STORAGE_DIR=
BACKUP_ENCRYPTION_KEY_B64=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_NOTIFY_EMAIL=
# Set these if PostgreSQL utilities are outside the worker's PATH.
PG_DUMP_BIN=
PG_RESTORE_BIN=
